rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // VISITORS COLLECTION - مجموعة الزوار
    // ============================================
    match /visitors/{visitorId} {
      // السماح بالقراءة والكتابة لعداد الزوار
      allow read, write: if true;
    }
    

    // ============================================
    // CONTACTS COLLECTION - مجموعة الرسائل
    // ============================================
    match /contacts/{contactId} {
      // منع القراءة للجميع (يمكن قراءتها فقط من Firebase Console أو المشرفين)
      allow read: if false;
      
      // السماح للجميع بإرسال رسائل
      allow create: if request.auth == null && 
                      request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'timestamp', 'read']) &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() >= 2 &&
                      request.resource.data.name.size() <= 100 &&
                      request.resource.data.email is string &&
                      request.resource.data.email.matches('^[\\w\\.-]+@[\\w\\.-]+\\.\\w+$') &&
                      request.resource.data.subject is string &&
                      request.resource.data.subject.size() >= 3 &&
                      request.resource.data.subject.size() <= 200 &&
                      request.resource.data.message is string &&
                      request.resource.data.message.size() >= 10 &&
                      request.resource.data.message.size() <= 2000;
      
      // منع التحديث والحذف
      allow update, delete: if false;
    }
    
    // ============================================
    // PROJECTS COLLECTION - مجموعة المشاريع
    // ============================================
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================
    // ANALYTICS COLLECTION - مجموعة التحليلات
    // ============================================
    match /analytics/{analyticsId} {
      allow read: if false;
      allow create: if request.auth == null;
      allow update, delete: if false;
    }

    // ============================================
    // ARTICLES COLLECTION - مجموعة المقالات
    // ============================================
    match /articles/{articleId} {
      // الزوار يقرؤون المقالات المنشورة فقط
      allow read: if resource.data.published == true;
      // الأدمن يقرأ ويكتب ويعدّل ويحذف
      allow read, write: if request.auth != null;
    }
    
    // رفض كل ما لم يُحدد
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
